<style>
  .payment-center { color: #5a2807; }
  .payment-hero { background: #d4c0a1; border: 1px solid #7a5a3a; padding: 14px; margin-bottom: 14px; }
  .payment-hero h2 { margin: 0 0 6px; font-size: 24px; }
  .payment-tabs { display: flex; gap: 6px; margin: 10px 0 14px; flex-wrap: wrap; }
  .payment-tabs a, .payment-tabs a:link, .payment-tabs a:visited { background: #174938; color: #fff1c8 !important; padding: 8px 14px; font-weight: bold; text-decoration: none; border: 1px solid #b58d44; text-shadow: 1px 1px #09251c; }
  .payment-tabs a:hover, .payment-tabs a:focus-visible { background: #205e48; color: #fff9e9 !important; }
  .payment-tabs a.active, .payment-tabs a.active:link, .payment-tabs a.active:visited { background: #0c3428; color: #fff1c8 !important; }
  .payment-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(185px, 1fr)); gap: 10px; margin-bottom: 14px; }
  .payment-package { background: #f1e0c6; border: 1px solid #9b7b55; padding: 10px; min-height: 92px; }
  .payment-package--selected { border-color: #9d7133; box-shadow: inset 0 0 0 1px #f4e4c8; }
  .payment-package strong { display: block; font-size: 17px; margin-bottom: 5px; }
  .payment-price { font-size: 20px; font-weight: bold; margin-top: 8px; }
  .payment-methods { display: grid; grid-template-columns: minmax(0, 2fr) minmax(240px, 1fr); gap: 12px; margin-bottom: 14px; }
  .payment-method { background: #d4c0a1; border: 1px solid #7a5a3a; padding: 12px; min-width: 0; }
  .payment-method--primary { background: #e0cfb1; border-color: #9d7133; box-shadow: inset 0 0 0 1px #f4e4c8; }
  .payment-method--secondary { background: #ceb998; }
  .payment-method__eyebrow { color: #80551e; font-size: 11px; font-weight: bold; margin-bottom: 5px; text-transform: uppercase; }
  .payment-method h3 { margin: 0 0 8px; font-size: 18px; }
  .payment-method form { max-width: 100%; }
  .payment-method select { box-sizing: border-box; display: block; width: 100%; max-width: 100%; margin-top: 6px; }
  .payment-button { display: inline-block; background: #174938; color: #fff4d6 !important; border: 1px solid #b58d44; padding: 8px 12px; font-weight: bold; text-decoration: none; margin-top: 6px; text-shadow: 1px 1px #09251c; }
  .payment-button:hover, .payment-button:focus-visible { background: #205e48; color: #fff9e9 !important; }
  .payment-message { padding: 10px; margin-bottom: 12px; border: 1px solid #7a5a3a; font-weight: bold; }
  .payment-message.success { background: #d7ead2; color: #1f5d23; }
  .payment-message.error { background: #efd0d0; color: #8a1c1c; }
  .payment-note { font-size: 12px; margin-top: 8px; }
  .payment-table-title { background: #143c30 !important; color: #fff1c8 !important; }
  .payment-table-title td, .payment-table-title th { color: #fff1c8 !important; }
  @media (max-width: 650px) { .payment-methods { grid-template-columns: 1fr; } }
</style>

<div class="payment-center">
  <div class="payment-hero">
    <h2>{{ t('payment.center_heading', 'Payment Center') }}</h2>
    <div>{{ t('payment.center_intro', 'Buy Coins or Premium time securely by credit or debit card. Crypto payments are verified manually.') }}</div>
  </div>

  {% if message %}
    <div class="payment-message {{ message.type }}">{{ message.text }}</div>
  {% endif %}

  <div class="payment-tabs">
    <a class="{% if selected_type == 'coins' %}active{% endif %}" href="?subtopic=donate&type=coins">{{ t('payment.coins', 'Coins') }}</a>
    <a class="{% if selected_type == 'premium' %}active{% endif %}" href="?subtopic=donate&type=premium">{{ t('payment.premium', 'Premium') }}</a>
  </div>

  {% set packages = selected_type == 'premium' ? premium_packages : coins_packages %}
  {% set currency_symbol = payment.currency == 'BRL' ? 'R$' : payment.currency %}
  {% set decimal_separator = payment.currency == 'BRL' ? ',' : '.' %}
  {% set thousands_separator = payment.currency == 'BRL' ? '.' : ',' %}
  <div class="TableContainer">
    <div class="CaptionContainer">
      <div class="CaptionInnerContainer">
        <span class="CaptionEdgeLeftTop" style="background-image:url({{ template_path }}/images/content/box-frame-edge.gif);"></span>
        <span class="CaptionEdgeRightTop" style="background-image:url({{ template_path }}/images/content/box-frame-edge.gif);"></span>
        <span class="CaptionBorderTop" style="background-image:url({{ template_path }}/images/content/table-headline-border.gif);"></span>
        <span class="CaptionVerticalLeft" style="background-image:url({{ template_path }}/images/content/box-frame-vertical.gif);"></span>
        <div class="Text">{% if selected_type == 'premium' %}{{ t('payment.premium_packages', 'Premium Packages') }}{% else %}{{ t('payment.coin_packages', 'Coin Packages') }}{% endif %}</div>
        <span class="CaptionVerticalRight" style="background-image:url({{ template_path }}/images/content/box-frame-vertical.gif);"></span>
        <span class="CaptionBorderBottom" style="background-image:url({{ template_path }}/images/content/table-headline-border.gif);"></span>
        <span class="CaptionEdgeLeftBottom" style="background-image:url({{ template_path }}/images/content/box-frame-edge.gif);"></span>
        <span class="CaptionEdgeRightBottom" style="background-image:url({{ template_path }}/images/content/box-frame-edge.gif);"></span>
      </div>
    </div>
    <table class="Table5" cellpadding="0" cellspacing="0">
      <tr>
        <td>
          <div class="InnerTableContainer">
            <div class="payment-grid">
              {% for package in packages %}
                <div class="payment-package{% if package.key == selected_package_key %} payment-package--selected{% endif %}">
                  <strong>{{ package.label }}</strong>
                  <div>{{ package.reward }}</div>
                  <div class="payment-price">{{ currency_symbol }} {{ package.price|number_format(2, decimal_separator, thousands_separator) }}</div>
                  <a class="payment-button" href="?subtopic=donate&type={{ selected_type }}&package={{ package.key }}#card-checkout">{{ t('payment.select_card_payment', 'Select card payment') }}</a>
                </div>
              {% else %}
                <div class="payment-package"><strong>{{ t('payment.no_packages', 'No packages configured.') }}</strong></div>
              {% endfor %}
            </div>
          </div>
        </td>
      </tr>
    </table>
  </div>

  <br>

  <div class="TableContainer">
    <div class="CaptionContainer">
      <div class="CaptionInnerContainer">
        <span class="CaptionEdgeLeftTop" style="background-image:url({{ template_path }}/images/content/box-frame-edge.gif);"></span>
        <span class="CaptionEdgeRightTop" style="background-image:url({{ template_path }}/images/content/box-frame-edge.gif);"></span>
        <span class="CaptionBorderTop" style="background-image:url({{ template_path }}/images/content/table-headline-border.gif);"></span>
        <span class="CaptionVerticalLeft" style="background-image:url({{ template_path }}/images/content/box-frame-vertical.gif);"></span>
        <div class="Text">{{ t('payment.methods', 'Payment Methods') }}</div>
        <span class="CaptionVerticalRight" style="background-image:url({{ template_path }}/images/content/box-frame-vertical.gif);"></span>
        <span class="CaptionBorderBottom" style="background-image:url({{ template_path }}/images/content/table-headline-border.gif);"></span>
        <span class="CaptionEdgeLeftBottom" style="background-image:url({{ template_path }}/images/content/box-frame-edge.gif);"></span>
        <span class="CaptionEdgeRightBottom" style="background-image:url({{ template_path }}/images/content/box-frame-edge.gif);"></span>
      </div>
    </div>
    <table class="Table5" cellpadding="0" cellspacing="0">
      <tr>
        <td>
          <div class="InnerTableContainer">
            <div class="payment-methods">
              <div class="payment-method payment-method--primary">
                <div class="payment-method__eyebrow">{{ t('payment.primary_method', 'Primary payment method') }}</div>
                <h3>{{ t('payment.card_title', 'Credit / Debit Card') }}</h3>
                <div>{{ t('payment.card_copy', 'Pay securely with Stripe Checkout.') }}</div>
                <a class="payment-button" href="#card-checkout">{{ t('payment.continue_to_checkout', 'Continue to checkout') }}</a>
              </div>
              <div class="payment-method payment-method--secondary">
                <div class="payment-method__eyebrow">{{ t('payment.alternative_method', 'Alternative payment method') }}</div>
                <h3>{{ t('payment.crypto', 'Crypto') }}</h3>
                <div>{{ t('payment.crypto_copy', 'Crypto donations are handled on the Donate page and reviewed manually.') }}</div>
                <div class="payment-note">{{ t('payment.crypto_review_notice', 'Crypto payments are reviewed manually. Credit may take longer after confirmation.') }}</div>
                <a class="payment-button" href="?subtopic=donations">{{ t('payment.view_crypto_wallets', 'View crypto wallets') }}</a>
              </div>
            </div>
          </div>
        </td>
      </tr>
    </table>
  </div>

  <br>

  <a id="card-checkout"></a>
  <form method="post" action="?subtopic=donate&type={{ selected_type }}#card-checkout">
    <input type="hidden" name="payment_action" value="stripe_checkout">
    <table border="0" cellpadding="4" cellspacing="1" width="100%">
    <tr class="payment-table-title">
      <th colspan="2"><strong>{{ t('payment.card_checkout', 'Card Checkout') }}</strong></th>
      </tr>
      <tr bgcolor="{{ config.darkborder }}">
        <td width="28%">{{ t('payment.account', 'Account') }}</td>
        <td><strong>{{ account_name }}</strong></td>
      </tr>
      <tr bgcolor="{{ config.lightborder }}">
        <td>{{ t('payment.product', 'Product') }}</td>
        <td>
          <select name="product_type" onchange="window.location='?subtopic=donate&type=' + this.value + '#card-checkout'">
            <option value="coins"{% if selected_type == 'coins' %} selected{% endif %}>{{ t('payment.coins', 'Coins') }}</option>
            <option value="premium"{% if selected_type == 'premium' %} selected{% endif %}>{{ t('payment.premium', 'Premium') }}</option>
          </select>
        </td>
      </tr>
      <tr bgcolor="{{ config.darkborder }}">
        <td>{{ t('payment.package', 'Package') }}</td>
        <td>
          <select name="package_key" required>
            {% for package in packages %}
              <option value="{{ package.key }}"{% if package.key == selected_package_key %} selected{% endif %}>{{ package.label }} - {{ currency_symbol }} {{ package.price|number_format(2, decimal_separator, thousands_separator) }}</option>
            {% endfor %}
          </select>
        </td>
      </tr>
      <tr bgcolor="{{ config.lightborder }}">
        <td colspan="2" style="text-align:center">
          {% if stripe_enabled %}
            <input class="payment-button" type="submit" value="{{ t('payment.proceed_to_stripe', 'Proceed to secure payment') }}">
            <div class="payment-note">{{ t('payment.card_checkout_notice', 'You will be redirected to Stripe to complete your payment securely.') }}</div>
          {% else %}
            <div class="payment-message error">{{ t('payment.card_unavailable', 'Card checkout is temporarily unavailable. Please try again later.') }}</div>
          {% endif %}
        </td>
      </tr>
    </table>
  </form>
</div>
