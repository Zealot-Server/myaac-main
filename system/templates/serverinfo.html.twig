<script>
  document.addEventListener('DOMContentLoaded', function() {
    var nextSave = {{ serverSaveTime }};
    var counter = document.getElementById('timerServerSaveInfo');
    function updateServerSave() {
      var now = Date.now();
      while (nextSave <= now) nextSave += 86400000;
      var remaining = Math.ceil((nextSave - now) / 1000);
      var hours = Math.floor(remaining / 3600);
      var minutes = Math.floor((remaining % 3600) / 60);
      var seconds = remaining % 60;
      counter.textContent = [hours, minutes, seconds].map(function(part) {
        return String(part).padStart(2, '0');
      }).join(':');
    }
    updateServerSave();
    setInterval(updateServerSave, 1000);
  });
</script>

