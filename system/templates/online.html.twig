<table border="0" width="100%">
	<tbody>
	<tr>
		<td width="50%" style="padding: 0px 5px 10px 0px;">
			<div class="TableContainer">
				<div class="CaptionContainer">
					<div class="CaptionInnerContainer">
						<span class="CaptionEdgeLeftTop" style="background-image:url(templates/tibiacom/images/global/content/box-frame-edge.gif);"></span>
						<span class="CaptionEdgeRightTop" style="background-image:url(templates/tibiacom/images/global/content/box-frame-edge.gif);"></span>
						<span class="CaptionBorderTop" style="background-image:url(templates/tibiacom/images/global/content/table-headline-border.gif);"></span>
						<span class="CaptionVerticalLeft" style="background-image:url(templates/tibiacom/images/global/content/box-frame-vertical.gif);"></span>
						<div class="Text">World Information</div>
						<span class="CaptionVerticalRight" style="background-image:url(templates/tibiacom/images/global/content/box-frame-vertical.gif);"></span>
						<span class="CaptionBorderBottom" style="background-image:url(templates/tibiacom/images/global/content/table-headline-border.gif);"></span>
						<span class="CaptionEdgeLeftBottom" style="background-image:url(templates/tibiacom/images/global/content/box-frame-edge.gif);"></span>
						<span class="CaptionEdgeRightBottom" style="background-image:url(templates/tibiacom/images/global/content/box-frame-edge.gif);"></span>
					</div></div>
				<table class="Table1" cellpadding="0" cellspacing="0">
					<tbody><tr>
						<td>
							<div class="InnerTableContainer">
								<table style="width: 100%">
									<tbody>
										<tr>
											<td width="25%" class="LabelV150">Status: </td>
											<td>{% if totalPlayers > 0 %}Players connected{% else %}No players connected{% endif %}</td>
										</tr>
										<tr>
											<td width="25%" class="LabelV150">Players Online:</td>
											<td>{{ totalPlayers }} {% if totalPlayers == 1 %}Player{% else %}Players{% endif %} Online</td>
										</tr>
										<tr>
											<td class="LabelV150">Online Record:</td>
											<td>{{ record ? record|raw : 'Not available' }}</td>
										</tr>
										<tr>
											<td class="LabelV150">Updated:</td>
											<td>{{ current_date }}</td>
										</tr>
									</tbody>
								</table>
							</div>
						</td>
					</tr></tbody>
				</table>
			</div>
		</td>
		<td width="50%" style="padding: 0px 0px 10px 5px;">
			<div class="TableContainer">
				<div class="CaptionContainer">
					<div class="CaptionInnerContainer">
						<span class="CaptionEdgeLeftTop" style="background-image:url(templates/tibiacom/images/global/content/box-frame-edge.gif);"></span>
						<span class="CaptionEdgeRightTop" style="background-image:url(templates/tibiacom/images/global/content/box-frame-edge.gif);"></span>
						<span class="CaptionBorderTop" style="background-image:url(templates/tibiacom/images/global/content/table-headline-border.gif);"></span>
						<span class="CaptionVerticalLeft" style="background-image:url(templates/tibiacom/images/global/content/box-frame-vertical.gif);"></span>
						<div class="Text">Frags</div>
						<span class="CaptionVerticalRight" style="background-image:url(templates/tibiacom/images/global/content/box-frame-vertical.gif);"></span>
						<span class="CaptionBorderBottom" style="background-image:url(templates/tibiacom/images/global/content/table-headline-border.gif);"></span>
						<span class="CaptionEdgeLeftBottom" style="background-image:url(templates/tibiacom/images/global/content/box-frame-edge.gif);"></span>
						<span class="CaptionEdgeRightBottom" style="background-image:url(templates/tibiacom/images/global/content/box-frame-edge.gif);"></span>
					</div></div>
				<table class="Table1" cellpadding="0" cellspacing="0">
					<tbody><tr>
						<td>
							<div class="InnerTableContainer">
								<table style="width: 100%; text-align: center">
									<tbody>
									<tr><td><img src="images/white_skull.gif" alt=""/> White skull: recent PvP attack</td></tr>
									{% if redSkullDay > 0 and redSkullWeek > 0 and redSkullMonth > 0 %}
									<tr><td><img src="images/red_skull.gif" alt=""/> Red skull: {{ redSkullDay }} daily, {{ redSkullWeek }} weekly or {{ redSkullMonth }} monthly unjustified kills</td></tr>
									<tr><td><img src="images/black_skull.gif" alt=""/> Black skull: {{ redSkullDay * 2 }} daily, {{ redSkullWeek * 2 }} weekly or {{ redSkullMonth * 2 }} monthly unjustified kills</td></tr>
									{% else %}<tr><td>Frag limits are currently unavailable.</td></tr>{% endif %}
									</tbody>
								</table>
							</div>
						</td>
					</tr></tbody>
				</table>
			</div>
		</td>
	</tr>
	</tbody>
</table>

<table border="0" cellpadding="0" cellspacing="0" width="100%"><tbody><tr>
		<td>
			<div class="TableContainer">
				<div class="CaptionContainer">
					<div class="CaptionInnerContainer">
						<span class="CaptionEdgeLeftTop" style="background-image:url(templates/tibiacom/images/global/content/box-frame-edge.gif);"></span>
						<span class="CaptionEdgeRightTop" style="background-image:url(templates/tibiacom/images/global/content/box-frame-edge.gif);"></span>
						<span class="CaptionBorderTop" style="background-image:url(templates/tibiacom/images/global/content/table-headline-border.gif);"></span>
						<span class="CaptionVerticalLeft" style="background-image:url(templates/tibiacom/images/global/content/box-frame-vertical.gif);"></span>
						<div class="Text">Vocations Status</div>
						<span class="CaptionVerticalRight" style="background-image:url(templates/tibiacom/images/global/content/box-frame-vertical.gif);"></span>
						<span class="CaptionBorderBottom" style="background-image:url(templates/tibiacom/images/global/content/table-headline-border.gif);"></span>
						<span class="CaptionEdgeLeftBottom" style="background-image:url(templates/tibiacom/images/global/content/box-frame-edge.gif);"></span>
						<span class="CaptionEdgeRightBottom" style="background-image:url(templates/tibiacom/images/global/content/box-frame-edge.gif);"></span>
					</div></div>
				<table class="Table5" cellpadding="0" cellspacing="0">
					<tbody><tr>
						<td>
							<div class="InnerTableContainer">
								<div style="display:flex; flex-wrap:wrap; gap:8px; justify-content:center;">
									{% for vocation in vocationFilters %}
										<a href="{{ vocation.url }}" {% if selectedVocation == vocation.key %}aria-current="page"{% endif %} style="display:inline-block; min-width:110px; padding:8px 12px; text-align:center; border:1px solid #846435; background:{% if selectedVocation == vocation.key %}#174333{% else %}#d4c0a1{% endif %}; color:{% if selectedVocation == vocation.key %}#fff3cf{% else %}#59320c{% endif %}; text-decoration:none; font-weight:bold;">
											{{ vocation.label }}<br><span style="font-weight:normal">{{ vocation.count }} online</span>
										</a>
									{% endfor %}
								</div>
							</div>
						</td>
					</tr></tbody>
				</table>
			</div>
		</td>
	</tr>
	</tbody>
</table>
<br>

<table border="0" cellpadding="0" cellspacing="0" width="100%"><tbody><tr>
		<td>
			<div class="TableContainer">
				<div class="CaptionContainer">
					<div class="CaptionInnerContainer">
						<span class="CaptionEdgeLeftTop" style="background-image:url(templates/tibiacom/images/global/content/box-frame-edge.gif);"></span>
						<span class="CaptionEdgeRightTop" style="background-image:url(templates/tibiacom/images/global/content/box-frame-edge.gif);"></span>
						<span class="CaptionBorderTop" style="background-image:url(templates/tibiacom/images/global/content/table-headline-border.gif);"></span>
						<span class="CaptionVerticalLeft" style="background-image:url(templates/tibiacom/images/global/content/box-frame-vertical.gif);"></span>
            <div class="Text">Players Online</div>
						<span class="CaptionVerticalRight" style="background-image:url(templates/tibiacom/images/global/content/box-frame-vertical.gif);"></span>
						<span class="CaptionBorderBottom" style="background-image:url(templates/tibiacom/images/global/content/table-headline-border.gif);"></span>
						<span class="CaptionEdgeLeftBottom" style="background-image:url(templates/tibiacom/images/global/content/box-frame-edge.gif);"></span>
						<span class="CaptionEdgeRightBottom" style="background-image:url(templates/tibiacom/images/global/content/box-frame-edge.gif);"></span>
					</div></div>
				<table class="Table3" cellpadding="0" cellspacing="0">
					<tbody><tr>
						<td>
							<div class="InnerTableContainer">
								<table style="width:100%;"><tbody><tr><td>
											<div class="TableContentContainer">
												<table class="TableContent" width="100%">
													<tbody>
													{% if players|length == 0 %}
													<tr style="text-align: center">
														<td>{% if totalPlayers == 0 %}Currently no one is playing on {{ config.lua.serverName }}.{% else %}No online players match this vocation.{% endif %}</td>
													</tr>
													{% else %}
													<tr bgcolor="#D4C0A1">
														{% if config.account_country %}
															<td class="LabelV150">#</td>
														{% endif %}
														{% if config.online_outfit %}
															<td class="LabelV150" style="width:80px; text-align:center;">Outfit</td>
														{% endif %}
														<td class="LabelV150">Name</td>
														<td class="LabelV150">Level</td>
														<td class="LabelV150">Vocation</td>
													</tr>
													{% set i = 0 %}
													{% for player in players %}
														{% set i = i + 1 %}
														<tr bgcolor="{{ getStyle(i) }}" style="height: 44px;">
															{% if config.account_country %}
																<td width="4%">{{ player.country_image|raw }}</td>
															{% endif %}
															{% if config.online_outfit %}
																<td width="80" style="height:88px; text-align:center; vertical-align:middle;">
																	<img src="{{ player.outfit }}" alt="" loading="lazy" onerror="this.onerror=null; this.src='{{ player.vocation_image }}';" style="display:block; width:64px; height:64px; object-fit:contain; margin:0 auto;" />
																</td>
															{% endif %}
											<td width="50%">{{ player.name|raw }}{{ player.skull|raw }}</td>
															<td>{{ player.level }}</td>
															<td>{{ player.vocation }}</td>
														</tr>
													{% endfor %}
													{% endif %}
													</tbody>
												</table>
											</div>
										</td></tr></tbody>
								</table>
							</div>
						</td>
					</tr></tbody>
				</table>
			</div>
		</td>
	</tr>
	</tbody>
</table>
<br>
